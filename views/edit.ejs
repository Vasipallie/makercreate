<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit <%= locals.project.get('Name') || "Project" %> - MakerCreate</title>
    <link rel="stylesheet" href="/css/project.css">
  </head>
  <body class="App App-header">
    <a href="/project/<%= locals.project.get('ProjectID') %>" class="prjbtn" style="align-self:flex-start;">← Back to Project</a>

    <form class="prjinfo" method="POST" action="/project/<%= locals.project.get('ProjectID') %>/edit" style="width:100%; max-width:500px;">
      <img class="prjimgi" src="<%= locals.project.get('Image') || '/images/default_project.png' %>" alt="Project Image">
      <label class="fieldlabel" for="Name">Name</label>
      <input class="fieldinput" type="text" id="Name" name="Name"
        value="<%= locals.project.get('Name') || '' %>" required>

      <label class="fieldlabel" for="Image">Image URL (get from hackclub-cdn)</label>
      <input class="fieldinput" type="url" id="Image" name="Image"
        value="<%= locals.project.get('Image') || '' %>">

      <div class="tags" style="width:100%;">
        <div style="flex:1;">
          <label class="fieldlabel" for="Category">Category</label>
          <select class="fieldinput" id="Category" name="Category">
            <% ["Software","Hardware","CAD"].forEach(function(opt) { %>
              <option value="<%= opt %>" <%= locals.project.get('Category') === opt ? 'selected' : '' %>>
                <%= opt %>
              </option>
            <% }); %>
          </select>
        </div>
      </div>

      <label class="fieldlabel" for="Description">Description</label>
      <textarea class="fieldinput" id="Description" name="Description" rows="5"
        ><%= locals.project.get('Description') || '' %></textarea>

      <label class="fieldlabel" for="Github">GitHub URL</label>
      <input class="fieldinput" type="url" id="Github" name="Github"
        value="<%= locals.project.get('Github') || '' %>">

      <label class="fieldlabel" for="Demo">Demo URL</label>
      <input class="fieldinput" type="url" id="Demo" name="Demo"
        value="<%= locals.project.get('Demo') || '' %>">

      <label class="fieldlabel" for="Hackatime">Hackatime Project</label>
      <select class="fieldinput" id="Hackatime" name="Hackatime">
        <option value="" disabled>None</option>

        <% hackatimeDatae.projects.forEach(function(project) { %>
          <option value="<%= project.name %>">
            <%= project.name %> (<%= (project.total_seconds / 3600).toFixed(1) %> hrs)
          </option>
        <% }) %>
      </select>

      <div class="tags" style="margin-top:0.5em;">
        <button type="submit" class="prjbtn">Save Changes</button>
        <a href="/project/<%= locals.project.get('ProjectID') %>" class="prjbtn">Cancel</a>
      </div>

    </form>
  </body>
</html>
