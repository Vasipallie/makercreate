<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= locals.title || "MakerCreate" %> - MakerCreate</title>
    <link rel="stylesheet" href="/css/project.css">
  </head>
  <body class="App App-header">
    <div class="imghold">
      <div class="buttonhold"></div>
      <% if (loggedout) { %>
        <a href="/" class="prjbtn">← MakerCreate</a>
      <% } else { %>
        <a href="/dashboard" class="prjbtn">← Dashboard</a>
      <% } %>
      
      <% if (locals.owner) { %>
        <a href="/edit/<%= locals.project.get('ProjectID') %>" class="prjbtn">Edit Project</a>
      <% } %>
      <img class="prjimg" src="<%= locals.project.get('Image') %>" alt="<%= locals.project.get('Name') %> Image">
    </div>
    <div class="prjinfo">
      <div class="tags">
        <tag><%= locals.project.get('Category') || "Uncategorized" %></tag>
        <tag><%= locals.project.get('Status') || "Unknown" %></tag><!-- 
        <tag><%= locals.project.get('HackHrs') || "Unknown" %></tag> -->
      </div>
      <h1 class="prjname"><%= locals.project.get('Name') || "Untitled Project" %></h1>
      <p class="prjdesc"><%= locals.project.get('Description') || "No description available." %></p>
      <div class="tags">
        <% if (locals.project.get('Github')) { %>
          <a class="prjbtn" href="<%= locals.project.get('Github') %>" target="_blank">GitHub</a>
        <% } %>
        <% if (locals.project.get('Demo')) { %>
          <a class="prjbtn" href="<%= locals.project.get('Demo') %>" target="_blank">Demo</a>
        <% } %>
      </div>
      <% if(locals.owner) { %>
        <a class="prjbtn" href="https://makercreate.fillout.com/t/88cDhoJGNQus?prjid=<%= locals.project.get('ProjectID') || '' %>&slackid=<%= locals.slackID || '' %>&projecttype=<%= locals.project.get('Category') || '' %>&email=<%= locals.email || '' %>&htimeprj=<%= locals.project.get('Hackatime') || '' %>&githubrepo=<%= locals.project.get('Github') || '' %>&demovid=<%= locals.project.get('Demo') || '' %>">Submit <%= locals.project.get('Name') || 'Project' %></a>
      <% } %>
    </div>
  </body>
</html>