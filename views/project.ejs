<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= locals.title || "MakerCreate" %> - MakerCreate</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/project.css">
  </head>
  <body class="App App-header">
    <div class="imghold">
      <div class="buttonhold"></div>
      <% if (loggedout) { %>
        <a href="/" class="prjbtn">← MakerCreate</a>
      <% } else { %>
        <a href="/dashboard" class="prjbtn">← Dashboard</a>
      <% } %>
      
      <% if (locals.owner) { %>
        <a href="/edit/<%= locals.project.get('ProjectID') %>" class="prjbtn">Edit Project</a>
      <% } %>
      <img class="prjimg" src="<%= locals.project.get('Image') %>" alt="<%= locals.project.get('Name') %> Image">
    </div>
    <div class="prjinfo">
      <div class="tags">
        <tag><%= locals.project.get('Category') || "Uncategorized" %></tag>
        <tag><%= locals.project.get('Status') || "Unknown" %></tag><!-- 
        <tag><%= locals.project.get('HackHrs') || "Unknown" %></tag> -->
      </div>
      <h1 class="prjname"><%= locals.project.get('Name') || "Untitled Project" %></h1>
      <p class="prjdesc"><%= locals.project.get('Description') || "No description available." %></p>
      <div class="tags">
        <% if (locals.project.get('Github')) { %>
          <a class="prjbtn" href="<%= locals.project.get('Github') %>" target="_blank">GitHub</a>
        <% } %>
        <% if (locals.project.get('Demo')) { %>
          <a class="prjbtn" href="<%= locals.project.get('Demo') %>" target="_blank">Demo</a>
        <% } %>
      </div>
      <% if(locals.owner) { %>
        <a class="prjbtn" href="https://makercreate.fillout.com/t/88cDhoJGNQus?prjid=<%= locals.project.get('ProjectID') || '' %>&slackid=<%= locals.slackID || '' %>&projecttype=<%= locals.project.get('Category') || '' %>&email=<%= locals.email || '' %>&htimeprj=<%= locals.project.get('Hackatime') || '' %>&githubrepo=<%= locals.project.get('Github') || '' %>&demovid=<%= locals.project.get('Demo') || '' %>">Submit <%= locals.project.get('Name') || 'Project' %></a>
        
        <div class="journal-creation" style="margin-top: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.2); padding-top: 1rem; width: 100%;">
          <h2 style="margin-bottom: 0.5em;">Create a Journal</h2>
          <div class="journal-tabs" style="display: flex; gap: 0.5em; margin-bottom: 0.5em;">
            <button id="edit-btn" class="prjbtn" style="background-color: #ffffff; color: #000000;">Edit</button>
            <button id="preview-btn" class="prjbtn">Preview</button>
          </div>
          <div id="edit-mode">
            <textarea id="journal-input" class="fieldinput" placeholder="Write your journal in Markdown... (Drag and drop or paste images here)" style="min-height: 150px; font-family: monospace;"></textarea>
            <div id="journal-requirements" style="font-size: 0.85em; color: #9b9b9b; margin-top: 0.3em;">
              Characters: <span id="char-count" style="color: var(--accent-danger, #ff6b6b);">0/200</span> | 
              Media: <span id="media-status" style="color: var(--accent-danger, #ff6b6b);">Required</span>
            </div>
          </div>
          <div id="preview-mode" class="fieldinput" style="display: none; min-height: 150px; background-color: rgba(0,0,0,0.2);"></div>
          
          <div style="margin-top: 10px;">
            <label for="journal-time" class="fieldlabel">Optional Journal Time (hrs):</label>
            <input type="number" id="journal-time" class="fieldinput" step="0.1" min="0" placeholder="e.g. 1.5">
          </div>
          
          <button id="submit-journal" class="prjbtn" style="margin-top: 10px;">Submit Journal</button>
          <div id="journal-error" style="color: var(--accent-danger, #ff6b6b); margin-top: 10px; font-size: 0.85em;"></div>
        </div>
      <% } %>

      <div class="journals-list" style="margin-top: 3rem; width: 100%;">
        <h2 style="margin-bottom: 0.5em;">Journals</h2>
        <% 
          let totalTime = parseFloat(locals.project.get('total_journaled_time') || 0) + parseFloat(locals.hackHrs || 0);
        %>
        <div class="tags" style="margin-bottom: 1em;">
          <tag>Total Time: <%= totalTime.toFixed(2) %> hrs</tag>
        </div>
        
        <% if (locals.journals && locals.journals.length > 0) { %>
          <% locals.journals.forEach(journal => { %>
            <div class="journal-entry" style="border: 1px solid rgba(255, 255, 255, 0.2); padding: 1em; margin-top: 1em; background-color: #1a1218;">
              <div class="journal-content markdown-body" data-markdown="<%= encodeURIComponent(journal.get('Journal')) %>"></div>
              <% if (journal.get('journal_time')) { %>
                <div class="fieldlabel" style="margin-top: 1em;">Time spent: <%= journal.get('journal_time') %> hrs</div>
              <% } %>
              <% if (locals.owner) { %>
                <button class="prjbtn delete-journal-btn" data-id="<%= journal.id %>" style="margin-top: 0.8em; border-color: #971414; color: #ff6b6b;">Delete</button>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <p class="prjdesc">No journals yet.</p>
        <% } %>
      </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
    <script>
      // Render existing journals
      document.querySelectorAll('.journal-content').forEach(el => {
        const markdown = decodeURIComponent(el.getAttribute('data-markdown'));
        el.innerHTML = DOMPurify.sanitize(marked.parse(markdown));
      });

      // Delete journal handler
      document.querySelectorAll('.delete-journal-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm('Are you sure you want to delete this journal?')) return;
          btn.disabled = true;
          btn.innerText = 'Deleting...';
          try {
            const res = await fetch(`/project/<%= locals.project.get('ProjectID') %>/journal/${btn.dataset.id}`, {
              method: 'DELETE'
            });
            const data = await res.json();
            if (data.success) {
              window.location.reload();
            } else {
              alert(data.error || 'Failed to delete.');
              btn.disabled = false;
              btn.innerText = 'Delete';
            }
          } catch(e) {
            alert('Network error.');
            btn.disabled = false;
            btn.innerText = 'Delete';
          }
        });
      });

      // Journal Creation Logic (only if owner)
      const submitJournalBtn = document.getElementById('submit-journal');
      if (submitJournalBtn) {
        const editBtn = document.getElementById('edit-btn');
        const previewBtn = document.getElementById('preview-btn');
        const editMode = document.getElementById('edit-mode');
        const previewMode = document.getElementById('preview-mode');
        const journalInput = document.getElementById('journal-input');
        const journalError = document.getElementById('journal-error');
        const charCountEl = document.getElementById('char-count');
        const mediaStatusEl = document.getElementById('media-status');

        const updateRequirements = () => {
          const val = journalInput.value;
          const len = val.length;
          charCountEl.innerText = `${len}/200`;
          charCountEl.style.color = len >= 200 ? '#4caf50' : 'var(--accent-danger, #ff6b6b)';

          const hasMedia = /!\[.*?\]\(.*?\)|<img.*?src=".*?".*?>/i.test(val) || /\[Video\]\(.*?\)/i.test(val);
          mediaStatusEl.innerText = hasMedia ? 'Added \u2714' : 'Required';
          mediaStatusEl.style.color = hasMedia ? '#4caf50' : 'var(--accent-danger, #ff6b6b)';
        };

        journalInput.addEventListener('input', updateRequirements);

        editBtn.addEventListener('click', () => {
          editMode.style.display = 'block';
          previewMode.style.display = 'none';
          editBtn.style.backgroundColor = '#ffffff';
          editBtn.style.color = '#000000';
          previewBtn.style.backgroundColor = 'transparent';
          previewBtn.style.color = '#ffffff';
        });

        previewBtn.addEventListener('click', () => {
          editMode.style.display = 'none';
          previewMode.style.display = 'block';
          previewBtn.style.backgroundColor = '#ffffff';
          previewBtn.style.color = '#000000';
          editBtn.style.backgroundColor = 'transparent';
          editBtn.style.color = '#ffffff';
          previewMode.innerHTML = DOMPurify.sanitize(marked.parse(journalInput.value || '*No content*'));
        });

        // File upload helper
        const uploadFile = async (file) => {
          const formData = new FormData();
          formData.append('file', file);
          try {
            const res = await fetch('/api/upload', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.url) {
              const isVideo = file.type.startsWith('video/');
              const insertText = isVideo ? `\n[Video](${data.url})\n` : `\n![Image](${data.url})\n`;
              const cursorPos = journalInput.selectionStart;
              journalInput.value = journalInput.value.substring(0, cursorPos) + insertText + journalInput.value.substring(journalInput.selectionEnd);
              updateRequirements();
            }
          } catch(e) {
            console.error(e);
            alert('Upload failed.');
          }
        };

        // Drag and drop
        journalInput.addEventListener('dragover', e => { e.preventDefault(); e.stopPropagation(); });
        journalInput.addEventListener('drop', e => {
          e.preventDefault(); e.stopPropagation();
          if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            Array.from(e.dataTransfer.files).forEach(uploadFile);
          }
        });

        // Paste
        journalInput.addEventListener('paste', e => {
          if (e.clipboardData.files && e.clipboardData.files.length > 0) {
            e.preventDefault();
            Array.from(e.clipboardData.files).forEach(uploadFile);
          }
        });

        // Submit
        submitJournalBtn.addEventListener('click', async () => {
          const content = journalInput.value;
          const time = document.getElementById('journal-time').value;
          
          if (content.length < 200) {
            journalError.innerText = 'Journal must be at least 200 characters.';
            return;
          }
          if (!/!\[.*?\]\(.*?\)|<img.*?src=".*?".*?>/i.test(content) && !/\[Video\]\(.*?\)/i.test(content)) {
            journalError.innerText = 'Journal must contain at least 1 image or video.';
            return;
          }
          
          journalError.innerText = 'Submitting...';
          submitJournalBtn.disabled = true;

          try {
            const res = await fetch(`/project/<%= locals.project.get('ProjectID') %>/journal`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ journalContent: content, journalTime: time })
            });
            const data = await res.json();
            if (data.success) {
              window.location.reload();
            } else {
              journalError.innerText = data.error || 'Failed to submit.';
              submitJournalBtn.disabled = false;
            }
          } catch(e) {
            journalError.innerText = 'Network error.';
            submitJournalBtn.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>