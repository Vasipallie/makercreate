<%- include('partials/head', { title: 'Settings', logs: locals.log, pfp: locals.pfp, name: locals.name }) %>


<a href="/dashboard" class="btn btn-back">← Back to Dashboard</a>

<div class="settings-header">
  <h1 class="page-title">./MakerCreate Settings</h1>
  <span class="section-subtitle">These are your settings, <%= locals.name || "" %></span>
</div>

<div class="section-container">
  <span class="section-title">About me</span>
  <span class="section-subtitle">Your account details pulled from HackClub Auth.</span>
  <div class="info-grid">
    <span class="label">Name</span>
    <span class="value"><%= (locals.name || "undefined") + " " + (locals.lname || "") %></span>
    <span class="label">YSWS Eligibility</span>
    <span class="value"><%= locals.ysws ?? "Unretrievable" %></span>
    <span class="label">Email</span>
    <span class="value"><%= locals.email ?? "Unretrievable" %></span>
    <span class="label">Slack ID</span>
    <span class="value"><%= locals.slackId ?? "Unretrievable" %></span>
    <span class="label">Hackatime</span>
    <span class="value"><%= locals.linked ? "Linked" : "Not Linked" %></span>
    <span class="label">Actual Logs</span>
    <span class="value"><%= locals.actuallogs ?? "—" %></span>
  </div>
  <div class="btn-row">
    <a href="https://auth.hackclub.com/identity/edit" class="btn btn-primary">Edit Profile on HCAuth</a>
  </div>
</div>

<div class="section-container">
  <span class="section-title">HackClub Policies</span>
  <span class="section-subtitle">Review our community guidelines and policies.</span>
  <div class="btn-row">
    <a href="https://hackclub.com/privacy-and-terms" class="btn btn-secondary">Privacy Policy</a>
    <a href="https://hackclub.com/conduct" class="btn btn-secondary">Code of Conduct</a>
  </div>
</div>

<div class="section-container" style="border-left: 4px solid var(--accent-danger); padding-left: 1rem;">
  <span class="section-title">Danger Zone</span>
  <span class="section-subtitle">These actions affect your session</span>
  <div class="btn-row">
    <a href="/logout" class="btn btn-danger">Logout of MakerCreate</a>
  </div>
</div>

<%- include('partials/foot') %>