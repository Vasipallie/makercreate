<%- include('partials/head', { title: 'Settings', logs: locals.log, pfp: locals.pfp, name: locals.name }) %>


<a href="/dashboard" class="back-btn">← Back to Dashboard</a>

<div class="settings-header">
  <h1>./MakerCreate Settings</h1>
  <span>These are your settings, <%= locals.name || "" %></span>
</div>

<div class="settings-section">
  <span class="settings-section-title">About me</span>
  <span class="settings-section-subtitle">Your account details pulled from HackClub Auth.</span>
  <div class="info-grid">
    <span class="label">Name</span>
    <span class="value"><%= (locals.name || "undefined") + " " + (locals.lname || "") %></span>
    <span class="label">YSWS Eligibility</span>
    <span class="value"><%= locals.ysws ?? "Unretrievable" %></span>
    <span class="label">Email</span>
    <span class="value"><%= locals.email ?? "Unretrievable" %></span>
    <span class="label">Slack ID</span>
    <span class="value"><%= locals.slackId ?? "Unretrievable" %></span>
    <span class="label">Hackatime</span>
    <span class="value"><%= locals.linked ? "Linked" : "Not Linked" %></span>
    <span class="label">Actual Logs</span>
    <span class="value"><%= locals.actuallogs ?? "—" %></span>
  </div>
  <div class="btn-row">
    <a href="https://auth.hackclub.com/identity/edit" class="abtn">Edit Profile on HCAuth</a>
  </div>
</div>

<div class="settings-section">
  <span class="settings-section-title">HackClub Policies</span>
  <span class="settings-section-subtitle">Review our community guidelines and policies.</span>
  <div class="btn-row">
    <a href="https://hackclub.com/privacy-and-terms" class="abtn">Privacy Policy</a>
    <a href="https://hackclub.com/conduct" class="abtn">Code of Conduct</a>
  </div>
</div>

<div class="settings-section" style="border-color: #971414;">
  <span class="settings-section-title">Danger Zone</span>
  <span class="settings-section-subtitle">These actions affect your session</span>
  <div class="btn-row">
    <a href="/logout" class="logout abtn">Logout of MakerCreate</a>
  </div>
</div>

<%- include('partials/foot') %>