<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MakerCreate - TermiUX</title>
    <link rel="stylesheet" href="css/dashboard.css">
  </head>
  <body class="App App-header crt">
    <div class="nav">
      <div class="promoter">
        <img alt="get slack logs for this" src="resources/promoter.png" class="promoterimg">
      </div>
      <div class="dashies">
        <a class="navitem" href="/dashboard"># dashboard</a>
        <a class="navitem" href="/makershop"># makershop™</a>
        <a class="navitem" href="/leaderboard"># leaderboard</a>
        <a class="navitem" href="/settings"># settings</a>
      </div>
      <div class="profiledata">
        <div class="currency">
          <img src="resources/log.png" alt="" class="logimg">
          <span class="logcount"><%= locals.log || 0 %> logs</span>
        </div>
        <hr>
        <div class="profi">
          <img src="<%= locals.pfp || 'resources/pfp.jpg' %>" alt="pfp" class="profileimg">
          <div class="profilt">
            <span class="pint">Welcome back!</span>
            <span class="pnam"><%= locals.name || "undefined" %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="content">
      <h1>./MakerCreate Settings</h1>
      <span>This is your settings page, <%= locals.name || "" %></span>

      <div class="">
        <h2>About me</h2>
        <span class="subtitle">This is information about you.</span>
        <p> Name: <%= locals.name || "undefined" %> <%= locals.lname || "" %></p>
        <p> YSWS Eligibility: <%= locals.ysws || "Unretrievable" %></p>
        <p> Email: <%= locals.email || "Unretrievable" %></p>
        <p> Slack ID: <%= locals.slackId || "Unretrievable" %></p>
        <a href="https://auth.hackclub.com/identity/edit" class="abtn">Edit Profile on HCAuth</a>
      </div>

      <a href="/logout" class="logout">Logout</a>
    </div>
    <script src="/js/clicks.js"></script>
  </body>
</html>
