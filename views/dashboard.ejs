<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MakerCreate - TermiUX</title>
    <link rel="stylesheet" href="css/dashboard.css">
  </head>
  <body class="App App-header crt">
    <div class="nav">
      <div class="promoter">
        <img alt="get slack logs for this" src="resources/promoter.png" class="promoterimg">
      </div>
      <div class="dashies">
        <a class="navitem" href="/dashboard"># dashboard</a>
        <a class="navitem" href="/makershop"># makershop™</a>
        <a class="navitem" href="/leaderboard"># leaderboard</a>
        <a class="navitem" href="/profile"># profile</a>
        <a class="navitem" href="/logout"># logout</a>
      </div>
      <div class="profiledata">
        <div class="currency">
          <img src="resources/log.png" alt="" class="logimg">
          <span class="logcount"><%= locals.log || 0 %> logs</span>
        </div>
        <hr>
        <div class="profi">
          <img src="<%= locals.pfp || 'resources/pfp.jpg' %>" alt="pfp" class="profileimg">
          <div class="profilt">
            <p class="pint">logged in as</p>
            <p class="pnam"><%= locals.name || "undefined" %></p>
          </div>
        </div>
      </div>
    </div>

    <div class="content">
      <h1>./MakerCreate Console</h1>
    </div>

  </body>
</html>
