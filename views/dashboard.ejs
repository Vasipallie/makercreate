<%- include('partials/head', { title: 'Dashboard', logs: locals.log, pfp: locals.pfp, name: locals.name }) %>

<h1>./MakerCreate Dashboard</h1>

 <% if (locals.linked === false || locals.linked === undefined){ %>
<div class="linkage">
    <p class="linkh">Link Hackatime</p>
    <p>Link hackatime to your MakerCreate account to track your coding activity.</p>
    <a  href="/hackatimeauth" class="btn">Link Account</a>
</div>
<% } %>

<h2>Your Projects</h2>
<p>These are your makercreate projects</p>
<div class="projects">

    <% if (locals.projects && locals.projects.length > 0) { %>
        <% locals.projects.forEach(project => { %>
            <a class="project" href="/project/<%= project.ProjectID %>" style="background-image: url('<%= project.image || '/resources/promoter.png' %>');">
                <div class="textareas">
                    <div class="tags">
                        <tag><%= project.category %></tag>
                        <tag><%= project.status %></tag>
                    </div>
                    <h1 class="titlep"><%= project.name %></h1>
                    <p class="descp"><%= project.description %></p>
                </div>
            </a>
        <% }); %>
    <% } else { %>
        <p>No projects found. Create a new project to get started!</p>
    <% } %>

    <a class="cprojec project" href="/createproject">
        <img src="/resources/upload.svg" alt="Add Project" class="addicon">
        <p>Create a New Project</p>
    </a>
</div>
<%- include('partials/foot') %>